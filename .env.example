# ── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:AA...your-bot-token-from-BotFather
# Secret used in the webhook URL (?secret=...) and for cron/setup endpoints
WEBHOOK_SECRET=pick-a-long-random-string
# Public HTTPS URL of the deployment, e.g. https://nexorasuperbot.vercel.app
PUBLIC_URL=https://your-app.vercel.app

# ── Database (Supabase Postgres) ────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-never-the-anon-key

# ── AI providers ────────────────────────────────────────────
# gemini (default, multimodal: text + vision + audio) or groq (text only)
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-or-groq-api-key
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b

# ── Web research ────────────────────────────────────────────
# tavily (recommended, free tier) or serper
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=your-tavily-or-serper-api-key

# ── Admin ───────────────────────────────────────────────────
# Comma-separated Telegram user IDs allowed to use /admin
ADMIN_IDS=123456789,987654321

# ── Limits & behaviour ──────────────────────────────────────
MAX_DOC_MB=10
MAX_IMAGE_MB=5
HISTORY_LIMIT=20
REMINDER_TZ=Africa/Lagos
